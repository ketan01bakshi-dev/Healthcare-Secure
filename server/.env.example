# Copy to .env and adjust for your environment.
# In production, JWT_SECRET is REQUIRED (the app refuses to start without it).
PORT=3001
HOST=0.0.0.0
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12
