NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Build-time default only. On the phone sign-in screen you can override
# "Clinic server address" (saved in localStorage) without rebuilding the APK.
# LAN example: http://192.168.1.19:8000
# Cloud (all clinics, same URL): https://api.yourproduct.in
# Bare hostnames with a dot default to https:// (e.g. api.yourproduct.in).
