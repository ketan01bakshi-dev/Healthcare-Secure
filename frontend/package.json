{
  "name": "healthcare-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "npx --yes serve out -p 3000",
    "lint": "next lint",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync && node scripts/fix-agp-proguard.mjs",
    "cap:open:android": "node scripts/open-android-studio.mjs",
    "cap:open:ios": "npx cap open ios",
    "fix:agp-proguard": "node scripts/fix-agp-proguard.mjs",
    "mobile:build": "npm run build && npx cap sync && node scripts/fix-agp-proguard.mjs",
    "mobile:android": "npm run mobile:build && npm run cap:open:android",
    "mobile:ios": "npm run mobile:build && npx cap open ios",
    "android:version": "node scripts/read-android-version.mjs"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^7.0.1",
    "@capacitor/android": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/ios": "^7.6.8",
    "@capacitor/share": "^7.0.4",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.0"
  }
}
