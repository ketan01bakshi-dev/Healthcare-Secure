APP_ENV=development
DEBUG=true
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
SECRET_SALT=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
DATABASE_URL=sqlite:///./healthcare.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://YOUR_LAN_IP:3000,http://localhost,https://localhost,capacitor://localhost
ALLOWED_HOSTS=localhost,127.0.0.1,YOUR_LAN_IP

# Whisper: local (CPU POC, $0) | openai | groq
# Keep PRELOAD=false so /health answers immediately (load model on first transcribe).
WHISPER_PROVIDER=local
# English demos: base.en. Hindi→English voice Rx needs multilingual (base, not *.en).
# If WHISPER_MODEL ends with .en, Hindi requests automatically use "base".
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_PRELOAD=false
# Optional extra STT keywords (comma-separated) merged into Whisper prompts
# STT_GLOSSARY=dydrogesterone,isosxuprine,मेफेनैमिक

# Clinical LLM parser: ollama (local $0) | openai | groq
# ollama serve && ollama pull llama3.2
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_API_KEY=ollama

# Public API base for native share / clipboard prescription download links
# Use your LAN IP when testing from a phone (patients open this URL).
PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Prescription letterhead template + auto date/time
CLINIC_NAME=Aarogya One Connect
CLINIC_SUBTITLE=Secure Clinical Prescription - De-identified Patient Record
CLINIC_ADDRESS=
DOCTOR_NAME=Dr. Nirmala Tiwari
DOCTOR_CREDENTIALS=MBBS
PRESCRIPTION_TIMEZONE=Asia/Kolkata
# Optional image assets (defaults: backend/app/assets/doctor_seal.png, letterhead.png)
# DOCTOR_SEAL_PATH=
# PRESCRIPTION_LETTERHEAD_PATH=

# Clinic users: user_id|Display Name|role|pin
# Roles: doctor | staff | receptionist | lab
# PIN may be plaintext (dev) or pbkdf2$... from scripts/hash_pin.py
# Example: doctor + staff + receptionist + lab
# CLINIC_USERS=dr_nirmala|Dr. Nirmala Tiwari|doctor|1234;staff_dhanaraj|Staff|staff|5678;reception1|Front Desk|receptionist|1111;lab1|Lab Desk|lab|9999
CLINIC_USERS=
DOCTOR_PIN=
# Refuse open local-doctor mode without users (also forced when APP_ENV=production)
REQUIRE_CLINIC_USERS=false
# Optional: ATTACHMENTS_DIR=D:/path/to/attachments

# Multi-clinic tenants (optional). Empty = single "default" clinic from CLINIC_NAME.
# CLINICS=id|Name|Address|Subtitle|clinic_password|features
# features: voice_rx,labs,queue,appointments,analytics,obstetric,video_consult (empty = all)
# CLINICS=default|Alpha Clinic|Shastri Nagar, Vidisha, Madhya Pradesh 464001|Obstetrics & Gynecology OPD|ClinicShare2026|voice_rx,labs,queue,appointments,analytics,obstetric,video_consult;gp|City General Clinic|12 Ring Road, Pune|General Medicine OPD|ClinicShare2026|voice_rx,labs,queue,appointments,analytics,video_consult
# Users: 4 fields = default clinic; 5 fields = clinic_id|user|name|role|pin
# CLINIC_USERS=default|dr_nirmala|Dr. Nirmala Tiwari|doctor|4829;gp|dr_gp|Dr Rajesh Kumar|doctor|3641;gp|staff_gp|Priya Sharma|staff|4582;gp|reception_gp|Front Desk|receptionist|5193;gp|lab_gp|Lab Desk|lab|6827
# Cloud / Hostinger multi-clinic template: see .env.cloud.example and docs/CLOUD_DEPLOY.md

# Video consult (Jitsi) — no call recording stored on this API
VIDEO_CONSULT_PROVIDER=jitsi
JITSI_BASE_URL=https://meet.jit.si

# ABDM / ABHA (sandbox approval from NHA required for live gateway)
# ABDM_MOCK=true uses OTP 123456 without calling NHA (dev/demo)
ABDM_MOCK=false
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_GATEWAY_URL=https://dev.abdm.gov.in/gateway
ABDM_CM_ID=sbx
ABDM_FACILITY_ID=
# Public HTTPS base registered with ABDM for callbacks, e.g. https://api.clinic.example
ABDM_CALLBACK_BASE_URL=

# SMS for appointments: none | console | msg91 | twilio
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=CLINIC
# SMS_MSG91_TEMPLATE_ID=
# SMS_ACCOUNT_SID=
# SMS_AUTH_TOKEN=
# SMS_FROM_NUMBER=
# Optional: shared secret for scripts/remind_day_before.cmd
# APPOINTMENT_REMINDER_TOKEN=

# Razorpay UPI QR (test keys from dashboard; leave blank to disable QR pay)
PAYMENTS_ENABLED=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_MOCK=true
