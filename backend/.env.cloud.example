# Aarogya One Connect — multi-clinic cloud (Hostinger) template
# Copy to backend/.env ON THE VPS ONLY. Never commit real secrets.
#
# Generate secrets:
#   openssl rand -hex 32

APP_ENV=production
DEBUG=false
SECRET_KEY=CHANGE_ME_OPENSSL_RAND_HEX_32
SECRET_SALT=CHANGE_ME_OPENSSL_RAND_HEX_32

# Compose sets DATABASE_URL to the db service; override password to match POSTGRES_PASSWORD.
# Example (password must match docker compose / .env POSTGRES_PASSWORD):
# DATABASE_URL=postgresql+psycopg2://healthcare:REPLACE_STRONG_PASSWORD@db:5432/healthcare
DATABASE_URL=postgresql+psycopg2://healthcare:REPLACE_STRONG_PASSWORD@db:5432/healthcare
POSTGRES_PASSWORD=REPLACE_STRONG_PASSWORD

# Shared public API host — same URL for every clinic's phones
PUBLIC_API_BASE_URL=https://api.YOUR_PRODUCT.in
ALLOWED_HOSTS=api.YOUR_PRODUCT.in
# Explicit origins. main.py also allows private LAN regex (192.168/10/172.16-31)
# so http://YOUR_LAN_IP:3000|3002 works against the cloud API without listing every IP.
CORS_ORIGINS=capacitor://localhost,https://localhost,http://localhost:3000,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3002,https://api.YOUR_PRODUCT.in,https://app.YOUR_PRODUCT.in

REQUIRE_CLINIC_USERS=true
WHISPER_PRELOAD=false
# Optional extra STT keywords (comma-separated) for Whisper prompts
# STT_GLOSSARY=dydrogesterone,isosxuprine

# Cloud STT / LLM (stock Docker image has no Whisper / Ollama)
# Hindi voice Rx uses translations + whisper-large-v3 (turbo is English-only path).
WHISPER_PROVIDER=groq
WHISPER_API_KEY=your_groq_api_key
WHISPER_MODEL=whisper-large-v3-turbo
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=your_groq_api_key

# Global PDF letterhead fallback (per-clinic branding via CLINICS rows is partial)
CLINIC_NAME=Aarogya One Connect
CLINIC_SUBTITLE=Secure Clinical Prescription - De-identified Patient Record
CLINIC_ADDRESS=
DOCTOR_NAME=Dr. Platform Admin
DOCTOR_CREDENTIALS=MBBS
PRESCRIPTION_TIMEZONE=Asia/Kolkata

# --- Multi-clinic tenancy (configure at least two for isolation smoke tests) ---
# Format: id|Display Name|Address|Subtitle|clinic_password_or_hash|features
# features (comma-separated): voice_rx,labs,queue,appointments,analytics,obstetric
# Empty features = all enabled. Hash passwords: backend\.venv\Scripts\python ..\scripts\hash_pin.py <pw>
# In Docker Compose env files, escape each $ in hashes as $$
CLINICS=default|Alpha Clinic|Shastri Nagar, Vidisha, Madhya Pradesh 464001|Obstetrics & Gynecology OPD|ClinicShare2026|voice_rx,labs,queue,appointments,analytics,obstetric,video_consult;east|East Branch|Sector 5||ClinicShare2026|voice_rx,labs,queue,appointments,analytics,obstetric,video_consult;gp|City General Clinic|12 Ring Road, Pune|General Medicine OPD|ClinicShare2026|voice_rx,labs,queue,appointments,analytics,video_consult

# Format: clinic_id|user_id|Display Name|role|pin
# Unique PINs per profile (do not reuse across users when sharing the APK).
CLINIC_USERS=default|dr_main|Dr Nirmala Tiwari|doctor|4829;default|staff_main|Staff|staff|5738;default|reception1|Front Desk|receptionist|6142;default|lab1|Lab Desk|lab|7391;east|dr_east|Dr East|doctor|8516;east|staff_east|Staff East|staff|9274;gp|dr_gp|Dr Rajesh Kumar|doctor|3641;gp|staff_gp|Priya Sharma|staff|4582;gp|reception_gp|Front Desk|receptionist|5193;gp|lab_gp|Lab Desk|lab|6827

# ABDM (optional; needs public HTTPS — set after go-live)
ABDM_MOCK=false
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_GATEWAY_URL=https://dev.abdm.gov.in/gateway
ABDM_CM_ID=sbx
ABDM_FACILITY_ID=
ABDM_CALLBACK_BASE_URL=https://api.YOUR_PRODUCT.in

# SMS (optional)
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=CLINIC

# Video consult (Jitsi) — media not stored on this VPS
VIDEO_CONSULT_PROVIDER=jitsi
JITSI_BASE_URL=https://meet.jit.si

# Razorpay UPI QR
PAYMENTS_ENABLED=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_MOCK=false
