# Staging-only env template. Copy to backend/.env.staging ON THE VPS.
# Never commit real secrets. Staging DB is wipeable (demo clinics only).
#
# DATABASE_URL must use the staging compose service hostname `db`
# and match POSTGRES_PASSWORD in docker-compose.staging.yml / .compose.env.

APP_ENV=staging
DEBUG=false
SECRET_KEY=CHANGE_ME_STAGING_OPENSSL_RAND_HEX_32
SECRET_SALT=CHANGE_ME_STAGING_OPENSSL_RAND_HEX_32

DATABASE_URL=postgresql+psycopg2://healthcare:healthcare_staging@db:5432/healthcare
POSTGRES_PASSWORD=healthcare_staging

PUBLIC_API_BASE_URL=https://staging-api.aarogyaoneconnect.in
ALLOWED_HOSTS=staging-api.aarogyaoneconnect.in
CORS_ORIGINS=capacitor://localhost,https://localhost,http://localhost:3000,https://staging-api.aarogyaoneconnect.in,https://staging-app.aarogyaoneconnect.in

REQUIRE_CLINIC_USERS=true
WHISPER_PRELOAD=false

WHISPER_PROVIDER=groq
WHISPER_API_KEY=
WHISPER_MODEL=whisper-large-v3-turbo
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=

CLINIC_NAME=Aarogya One Connect Staging
CLINIC_SUBTITLE=Staging — demo data only
CLINIC_ADDRESS=
DOCTOR_NAME=Dr. Staging
DOCTOR_CREDENTIALS=MBBS
PRESCRIPTION_TIMEZONE=Asia/Kolkata

# Demo clinics only (same shapes as production demo)
CLINICS=default|Alpha Clinic|Shastri Nagar, Vidisha, Madhya Pradesh 464001|Obstetrics & Gynecology OPD|ClinicShare2026|voice_rx,labs,queue,appointments,analytics,obstetric,video_consult;gp|City General Clinic|12 Ring Road, Pune|General Medicine OPD|ClinicShare2026|voice_rx,labs,queue,appointments,analytics,video_consult

CLINIC_USERS=default|dr_main|Dr Nirmala Tiwari|doctor|4829;default|staff_main|Staff|staff|5738;default|reception1|Front Desk|receptionist|6142;default|lab1|Lab Desk|lab|7391;gp|dr_gp|Dr Rajesh Kumar|doctor|3641;gp|staff_gp|Priya Sharma|staff|4582;gp|reception_gp|Front Desk|receptionist|5193;gp|lab_gp|Lab Desk|lab|6827

ABDM_MOCK=true
SMS_PROVIDER=console
PAYMENTS_ENABLED=false
VIDEO_CONSULT_PROVIDER=jitsi
JITSI_BASE_URL=https://meet.jit.si
